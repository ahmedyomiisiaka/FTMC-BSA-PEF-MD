; ============================================================
; BSA CONTROL PRODUCTION MD
; Preliminary production run: 5 ns
; No external electric field
; ============================================================

title                   = BSA control production MD - 5 ns

; Run control
integrator              = md
dt                      = 0.002
nsteps                  = 2500000

; Continue from equilibrated NPT system
continuation            = yes
gen_vel                 = no

; Bond constraints
constraint_algorithm    = lincs
constraints             = h-bonds
lincs_iter              = 1
lincs_order             = 4

; Neighbor searching
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.0

; Electrostatics
coulombtype             = PME
rcoulomb                = 1.0

; Van der Waals interactions
vdwtype                 = Cut-off
rvdw                    = 1.0

; Temperature coupling
tcoupl                  = V-rescale
tc-grps                 = Protein non-Protein
tau_t                   = 0.1 0.1
ref_t                   = 300 300

; Pressure coupling
pcoupl                  = C-rescale
pcoupltype              = isotropic
tau_p                   = 5.0
ref_p                   = 1.0
compressibility         = 4.5e-5

; Periodic boundary conditions
pbc                     = xyz

; Output control
nstxout-compressed      = 5000
nstenergy               = 500
nstlog                  = 500